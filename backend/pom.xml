<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent POM kế thừa từ spring-boot-starter-parent.
        Nhờ đó mọi dependency của Spring không cần khai <version> ở module con —
        Spring Boot đã quản lý version tương thích sẵn.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.orderflow</groupId>
    <artifactId>orderflow-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OrderFlow</name>
    <description>Event-driven order processing platform</description>

    <!--
        packaging=pom nghĩa là module này không sinh ra file .jar nào.
        Nó chỉ tồn tại để gom các module con lại và khai báo cấu hình dùng chung.
    -->
    <modules>
        <module>shared/event-contracts</module>
        <module>services/api-gateway</module>
        <module>services/order-service</module>
        <module>services/inventory-service</module>
        <module>services/payment-service</module>
        <module>services/notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-cloud.version>2023.0.3</spring-cloud.version>

        <!--
            Đè version mà Spring Boot 3.3.5 quản lý (1.19.8).
            Lý do: 1.19.8 kéo theo docker-java 3.3.6, client này gửi Docker API
            version cũ. Docker Engine 29 yêu cầu API tối thiểu 1.44 nên từ chối
            với "Status 400" và Testcontainers báo "Could not find a valid
            Docker environment" — thông điệp gây hiểu nhầm là chưa bật Docker.
        -->
        <testcontainers.version>1.21.3</testcontainers.version>

        <!--
            Docker API version mà docker-java sẽ dùng. Để trống nghĩa là
            "tự thương lượng" — đúng cho Linux/CI. Profile bên dưới ghi đè
            cho Windows, xem giải thích ở đó.
        -->
        <docker.api.version/>
        <redisson.version>3.34.1</redisson.version>
        <springdoc.version>2.6.0</springdoc.version>
        <mapstruct.version>1.6.2</mapstruct.version>
    </properties>

    <!--
        dependencyManagement chỉ KHAI BÁO version, không thêm dependency thật.
        Module con muốn dùng thì vẫn phải khai <dependency>, nhưng bỏ được <version>.
        Nhờ vậy nâng version chỉ cần sửa một chỗ duy nhất.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                Tracing (tuần 8): KHÔNG import BOM của OpenTelemetry. Spring Boot 3.3
                đã quản lý version OpenTelemetry khớp với micrometer-tracing-bridge-otel;
                import BOM khác (vd. opentelemetry-instrumentation-bom) sẽ đè version đó
                và dễ lệch API giữa bridge và SDK.
            -->

            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Module nội bộ: event contract dùng chung cho mọi service -->
            <dependency>
                <groupId>com.orderflow</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Dependency đặt ở đây thì MỌI module con đều nhận được, không cần khai lại.
        Chỉ để những thứ thật sự dùng ở khắp nơi.
    -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Failsafe chạy integration test (*IT.java) ở pha `verify`.
                Surefire chỉ chạy unit test (*Test.java) ở pha `test`.

                Tách đôi có chủ đích: `mvn test` phải nhanh và không cần Docker,
                còn `mvn verify` mới dựng container. Nhờ vậy vòng lặp sửa-chạy
                hằng ngày không phải chờ Testcontainers khởi động.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            WINDOWS + DOCKER DESKTOP
            ========================
            Docker Desktop trên Windows nói chuyện qua named pipe, và bản
            Engine 29 yêu cầu API version TỐI THIỂU 1.44. docker-java lại gửi
            một version cũ hơn, nên bị từ chối với "Status 400" kèm payload
            rỗng — và Testcontainers dịch thành thông điệp gây hiểu nhầm:
            "Could not find a valid Docker environment", làm ai cũng tưởng
            là chưa bật Docker Desktop.

            Kiểm chứng nhanh bằng chính Docker CLI:
                DOCKER_API_VERSION=1.43 docker info   -> 400 y hệt
                DOCKER_API_VERSION=1.44 docker info   -> OK

            Chỉ ghi đè trên Windows, KHÔNG áp cho Linux/CI: ép cứng 1.44 ở đó
            sẽ hỏng nếu runner chạy Docker đời cũ hơn 25.0.
        -->
        <profile>
            <id>windows-docker</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <docker.api.version>1.44</docker.api.version>
            </properties>
        </profile>
    </profiles>
</project>
